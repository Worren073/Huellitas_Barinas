# ============================================================================
# HUELLITAS BARINAS - Environment Variables Template
# ============================================================================
# Copy this file to .env and fill in the actual values
# NEVER commit .env to git - it contains secrets!
# ============================================================================

# ============================================================================
# DJANGO CORE
# ============================================================================

# Django settings module (development or production)
DJANGO_SETTINGS_MODULE=config.settings.development

# Secret key for cryptographic signing (generate with: python manage.py shell -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())")
# CRITICAL: Must be 50+ characters and random
SECRET_KEY=your-super-secret-random-key-here-change-in-production

# Debug mode (only True in development)
DEBUG=True

# Allowed hosts (comma-separated, no spaces)
# Examples: localhost,127.0.0.1,yourdomain.com,www.yourdomain.com
ALLOWED_HOSTS=localhost,127.0.0.1

# ============================================================================
# DATABASE - PostgreSQL
# ============================================================================

# Option 1: Use individual variables
DB_NAME=huellitas_barinas
DB_USER=postgres
DB_PASSWORD=your-db-password-here
DB_HOST=localhost
DB_PORT=5432

# Option 2: Use DATABASE_URL (takes precedence over individual vars)
# Format: postgresql://user:password@host:port/dbname
# For Render PostgreSQL: use the connection string from Render dashboard
# DATABASE_URL=

# ============================================================================
# REDIS & CACHING
# ============================================================================

# Redis URL for Celery, cache, and sessions
# Local: redis://localhost:6379/0
# With password: redis://:password@localhost:6379/0
REDIS_URL=redis://localhost:6379/0

# Run migrations on startup
RUN_MIGRATIONS=true
# ============================================================================
# EMAIL CONFIGURATION
# ============================================================================

# Email backend (smtp.gmail.com for Gmail, smtp.your-provider.com for others)
EMAIL_HOST=smtp.gmail.com

# SMTP port (587 for TLS, 465 for SSL)
EMAIL_PORT=587

# Email account username
EMAIL_HOST_USER=your-email@gmail.com

# Email account password (for Gmail, use App Password, not account password)
EMAIL_HOST_PASSWORD=your-app-specific-password

# Default sender email
DEFAULT_FROM_EMAIL=Huellitas Barinas <noreply@huellitasbarinas.com>

# ============================================================================
# CORS - Cross-Origin Resource Sharing
# ============================================================================

# Allowed origins for API requests (comma-separated, no spaces)
# Include frontend URL
# Examples: http://localhost:3000,https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000

# ============================================================================
# FRONTEND
# ============================================================================

# Frontend API URL (what frontend uses to call API)
# Development: http://localhost:8000
# Production: https://api.yourdomain.com
NEXT_PUBLIC_API_URL=http://localhost:8000

# ============================================================================
# MONITORING & LOGGING
# ============================================================================

# Sentry DSN for error tracking (optional)
# Get from: https://sentry.io/
SENTRY_DSN=

# Environment name for logs (development, staging, production)
ENVIRONMENT=development

# ============================================================================
# DEVELOPMENT ONLY
# ============================================================================

# Allow all CORS origins (NEVER in production)
CORS_ALLOW_ALL_ORIGINS=False

# ============================================================================
# NOTES
# ============================================================================
# 1. Copy this file to .env in the project root
# 2. Fill in all values marked with "your-..." or "change-..."
# 3. For production, use strong random values for SECRET_KEY
# 4. Never commit .env file to git
# 5. For Render/Heroku, set these as environment variables in the dashboard
# 6. For Gmail, generate App Password: https://myaccount.google.com/apppasswords
# 7. For Render PostgreSQL, set DATABASE_URL in Render dashboard
